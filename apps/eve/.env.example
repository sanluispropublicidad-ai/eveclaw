# Copy to .env.local and fill in real values (never commit .env.local).
# On Vercel, `vercel env pull` writes most of these for you, including the
# VERCEL_OIDC_TOKEN that eve uses to reach the AI Gateway in development.

# --- Model provider (optional) --------------------------------------------
# With all three set, the agent talks straight to that OpenAI-compatible
# provider instead of Vercel's AI Gateway (see agent/agent.ts). This is what
# makes a provider like Vyce work. Leave them empty to route through the
# gateway. LLM_MODEL must be an id that provider knows — bare slugs like
# "deepseek-v4-flash", not gateway ids like "vendor/model".
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# --- Database (Neon Postgres) ---------------------------------------------
# Threads, receipts, reminders, webhooks, automation runs, push subscriptions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Long-term memory (Supermemory) ---------------------------------------
SUPERMEMORY_API_KEY="sm_..."

# --- App integrations (Composio) ------------------------------------------
# Consumer API key used for tool calls and the Connections manager.
COMPOSIO_API_KEY="ck_..."

# --- File sharing (Vercel Blob) -------------------------------------------
# Backs the share_file tool and the chat-created skill store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Web search (authored override) ---------------------------------------
# agent/tools/web_search.ts replaces eve's provider-managed web_search, which
# only exists for openai/anthropic/google/gateway models. Without these keys
# the tool raises "EXA_API_KEY is not set." Exa reads page text; Serper is
# Google results. Either one alone is enough if you only use that provider.
EXA_API_KEY=""
SERPER_API_KEY=""

# --- Web push notifications -----------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Reminder cadence -----------------------------------------------------
# Cron for the reminders dispatcher. Defaults to "0 13 * * *" (07:00 in
# Mexico) because the Vercel Hobby plan only allows daily crons — on Hobby a
# reminder set for the afternoon will not fire until the next morning. On Pro
# set "* * * * *" for minute-accurate delivery.
REMINDER_CRON=""

# --- Web access (REQUIRED in production) ----------------------------------
# The web chat and every /api/* route require this credential (HTTP Basic, so
# the browser asks once per device). Both the eve channel gate and the route
# guard read it. With no password set, a public origin serves nothing and only
# loopback keeps working.
EVE_WEB_USER="igi"
EVE_WEB_PASSWORD=""

# --- Identity shown in the UI ---------------------------------------------
# Read by lib/identity.ts and agent/lib/owner.ts. OWNER_NAME is what the agent
# calls the person it works for; NEXT_PUBLIC_* are baked into the web bundle.
NEXT_PUBLIC_AGENT_NAME=""
NEXT_PUBLIC_OWNER_NAME=""
OWNER_NAME=""

# --- Telegram channel (optional) ------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET_TOKEN=""
# Comma-separated Telegram user ids allowed to DM the bot.
TELEGRAM_ALLOWED_USER_IDS=""
